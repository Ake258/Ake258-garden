filters:
  and:
    - file.inFolder("02Area/Notes")
    - file.ext == "md"
properties:
  章节:
    displayName: 章节
  对象类型:
    displayName: 对象类型
  加工进度:
    displayName: 加工进度
  学科:
    displayName: 学科
views:
  - type: kanban
    name: index
    groupBy:
      property: 章节
      direction: ASC
    order:
      - file.name
      - 对象类型
      - 加工进度
  - type: table
    name: 1.01牙体牙髓绪论
    filters:
      and:
        - 章节.contains("1.01牙体牙髓绪论")
    order:
      - file.name
      - 对象类型
      - 加工进度
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 2.01牙周绪论
    filters:
      and:
        - 章节.contains("2.01牙周绪论")
    order:
      - file.name
      - 对象类型
      - 加工进度
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 2.02牙周组织的应用解剖和生理
    filters:
      and:
        - 章节.contains("2.02牙周组织的应用解剖和生理")
    order:
